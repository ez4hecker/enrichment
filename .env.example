# Copy to .env and fill in. Never commit .env.
# Used both by docker compose (for ${...} values) and as the backend's environment.

# ---- Docker stack ----------------------------------------------------------
# Postgres password: letters and digits only (it goes into a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Port nginx publishes on the host. 80 on the VPS; e.g. 8080 on a dev PC where 80 is taken.
HTTP_PORT=80
# Address it publishes on: 0.0.0.0 to serve directly, 127.0.0.1 behind a host nginx that holds the domain.
HTTP_BIND=0.0.0.0
# Public origin the site is reached at, e.g. http://203.0.113.10 (baked into the frontend build).
SITE_ORIGIN=

# DATABASE_URL, REDIS_URL, OUTPUT_ARTIFACT_DIRECTORY, HOST and PORT are set by docker-compose.yml.

# ---- Backend ---------------------------------------------------------------
# Required OpenAI deployment configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional: defaults to https://api.openai.com/v1
OPENAI_API_BASE_URL=


# Worker and recovery controls.
WORKER_CONCURRENCY=4
LEASE_DURATION_MILLISECONDS=600000
DISPATCH_RECONCILIATION_INTERVAL_MILLISECONDS=30000

# Browser session configuration. Keep Secure enabled when users connect over
# HTTPS; set false only for local HTTP development.
SESSION_DURATION_MILLISECONDS=2592000000
SESSION_COOKIE_SECURE=false

# Shared OpenAI provider controls.
OPENAI_TIMEOUT_MILLISECONDS=30000
OPENAI_MAXIMUM_ATTEMPTS=3
OPENAI_RETRY_DELAY_MILLISECONDS=500
OPENAI_MAXIMUM_CONCURRENT_REQUESTS=5
# Separate request slots for interactive previews, so a running job never delays them.
OPENAI_PREVIEW_MAXIMUM_CONCURRENT_REQUESTS=10
# reasoning.effort sent to the model (none, low, medium, ...); "default" omits it. Defaults to low.
OPENAI_REASONING_EFFORT=low

# AI Research chain (Company Dossier -> Gemini key pool -> Serper + reader -> page fetch).
# Paid search for rows the Dossier and pool cannot answer. Without it they get [Not Found].
SERPER_API_KEY=
# Price per 1,000 Serper searches for your credit pack; used for the Spend Limit.
SERPER_DOLLARS_PER_THOUSAND_SEARCHES=1.00
# Encrypts Gemini keys added on the Research Keys page. At least 32 random characters.
# Changing it makes stored keys unreadable; they then have to be added again.
RESEARCH_KEY_ENCRYPTION_SECRET=
# Highest external research spend per Enrichment Job, in dollars.
RESEARCH_SPEND_LIMIT_DOLLARS=3.50
# How long a job waits for free pool searches before the remaining rows use paid search.
RESEARCH_POOL_DEADLINE_MINUTES=60
# Free-tier keys: grounded searches per key per Pacific day (Google allows 500) and pacing.
GEMINI_POOL_KEY_DAILY_SEARCH_LIMIT=450
GEMINI_POOL_KEY_REQUESTS_PER_MINUTE=10
# Optional: the company's billed Gemini key, used only within its free 1,500/day allowance.
GEMINI_BILLED_API_KEY=
GEMINI_BILLED_DAILY_SEARCH_LIMIT=1400
# Gemini 2.5 Flash/Flash-Lite are the only models with free-tier grounded search.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash-lite
# Reader for search snippets, pages and Dossiers.
RESEARCH_READER_MODEL=gpt-5-nano
RESEARCH_READER_REASONING_EFFORT=minimal
COMPANY_DOSSIER_RETENTION_DAYS=90

# Lead Lookup (find the closest person or company in LeadOcean for each row).
# Key from https://app.leadocean.io/keys with the search and enrich scopes. Without it lookups get [Not Found].
LEADOCEAN_API_KEY=
# Candidates fetched per row when there is no LinkedIn URL, email, phone or website to look up exactly.
# Each candidate is one LeadOcean record; the closest one is kept. Defaults to 3.
LEADOCEAN_SEARCH_CANDIDATES=
# When the first page has no confident match (colleagues who mention the person can fill it),
# one deeper search fetches this many candidates. Defaults to 10.
LEADOCEAN_DEEP_SEARCH_CANDIDATES=
# Closest matches scoring below this (0-1) are written as [Not Found]. Defaults to 0.5.
LEADOCEAN_MINIMUM_MATCH_CONFIDENCE=
# Parallel requests to LeadOcean; the free plan allows 5 a second. Defaults to 4.
LEADOCEAN_MAXIMUM_CONCURRENT_REQUESTS=
